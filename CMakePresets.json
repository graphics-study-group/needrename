{
    "version": 3,
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (clang)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
                "Python3_EXECUTABLE": "${sourceDir}/.venv/bin/python"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (clang)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
                "Python3_EXECUTABLE": "${sourceDir}/.venv/bin/python"
            }
        },
        {
            "name": "msvc",
            "displayName": "Windows MSVC (Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/msvc",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
                "Python3_EXECUTABLE": "${sourceDir}/.venv/Scripts/python.exe"
            }
        },
        {
            "name": "emscripten",
            "displayName": "Emscripten browser build (WebGPU)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/emscripten",
            "toolchainFile": "${sourceDir}/cmake/toolchains/emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install-emscripten",
                "ENGINE_RHI_BACKEND": "webgpu",
                "ENGINE_BUILD_APPS": "OFF",
                "ENGINE_BUILD_DOCS": "OFF",
                "ENGINE_BUILD_TESTS": "OFF",
                "ENGINE_SHADER_MODE": "spv",
                "ENGINE_BUILD_TOOLS": "ON",
                "Python3_EXECUTABLE": "${sourceDir}/.venv/Scripts/python.exe"
            }
        },
        {
            "name": "webgpu-desktop",
            "displayName": "Desktop WebGPU validation build (wgpu-native or Dawn)",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/webgpu",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install-webgpu",
                "ENGINE_RHI_BACKEND": "webgpu",
                "ENGINE_BUILD_APPS": "OFF",
                "ENGINE_BUILD_DOCS": "OFF",
                "ENGINE_BUILD_WEBGPU_SPIKE": "ON",
                "Python3_EXECUTABLE": "${sourceDir}/.venv/Scripts/python.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "msvc-debug",
            "configurePreset": "msvc",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc",
            "configuration": "Release"
        },
        {
            "name": "emscripten",
            "configurePreset": "emscripten"
        },
        {
            "name": "webgpu-desktop",
            "configurePreset": "webgpu-desktop",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "msvc-debug",
            "configurePreset": "msvc",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc",
            "configuration": "Release"
        }
    ]
}


