<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal hand-written robot used by the needrename-sim test suite.

  Three links (base + 2) and two revolute joints, box collision geometry, no
  meshes: importing it in physics-only mode needs no asset files beyond the
  wheel's data. Masses and inertias are deliberately unremarkable values, so the
  joints are numerically well conditioned under the solver's substep size.
  Joint limits are recorded but never enforced by the engine.
-->
<robot name="minimal_robot">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1042" ixy="0" ixz="0" iyy="0.1042" iyz="0" izz="0.2083"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.5 0.2"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0208" ixy="0" ixz="0" iyy="0.0208" iyz="0" izz="0.0150"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.4"/>
      </geometry>
    </collision>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0127" ixy="0" ixz="0" iyy="0.0127" iyz="0" izz="0.0104"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.3"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.5" upper="1.5" velocity="5.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" lower="-1.0" upper="1.0" velocity="4.0"/>
  </joint>
</robot>
