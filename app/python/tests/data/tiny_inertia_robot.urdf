<?xml version="1.0" encoding="utf-8"?>
<!--
  Small-inertia link fixture for the inertia-invertibility regression test.

  The "ball" link uses the Unitree A1 foot's inertial values (mass 0.06, diag(9.6e-6)):
  its inertia determinant is 8.85e-16, which the engine used to reject as singular and
  silently replace with a zero inverse inertia. A body with zero inverse inertia cannot
  rotate, and if it is welded to a parent by a fixed joint it freezes that parent too.
-->
<robot name="tiny_inertia_robot">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0133" ixy="0" ixz="0" iyy="0.0133" iyz="0" izz="0.0133"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="ball">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="9.6e-06" ixy="0.0" ixz="0.0" iyy="9.6e-06" iyz="0.0" izz="9.6e-06"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="ball_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="ball"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.0" upper="3.0" velocity="20.0"/>
  </joint>
</robot>
