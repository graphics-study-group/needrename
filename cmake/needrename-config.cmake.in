@PACKAGE_INIT@

# CMake package for the installed engine distribution.
#
# Usage:
#   find_package(needrename CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE needrename::Engine)
#
# Exported targets use the `needrename::` namespace. The package resolves the
# engine's external dependencies (SDL3, Vulkan, Threads) from the consumer
# machine instead of assuming the build machine's layout.

include(CMakeFindDependencyMacro)

find_dependency(SDL3 CONFIG COMPONENTS SDL3-shared)
find_dependency(Vulkan)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/needrenameTargets.cmake")

# Layout of this installation (see the runtime-data-resolution spec).
#
# @PACKAGE_INIT@ above derives PACKAGE_PREFIX_DIR from this file's own location,
# so the package works for any install prefix, including one passed only to
# `cmake --install --prefix` (which never reaches CMAKE_INSTALL_PREFIX).
set(NEEDRENAME_DATA_ROOT "${PACKAGE_PREFIX_DIR}/@NEEDRENAME_DATA_ROOT_REL@")
set(NEEDRENAME_REFLECTION_PARSER_DIR "${NEEDRENAME_DATA_ROOT}/reflection/parser")
set(NEEDRENAME_REFLECTION_TYPE_LISTS_DIR "${NEEDRENAME_DATA_ROOT}/reflection/type_lists")

include("${CMAKE_CURRENT_LIST_DIR}/needrenameReflection.cmake")

check_required_components(needrename)
