#version 450 core

// Block-offset addition pass for multi-level parallel prefix sum.
//
// Each workgroup adds BlockSums[block_offset + wg_id] to every element in
// its 512-element block.  This replaces mode=2 in parallel_scan.comp,
// avoiding the in-place re-scan bug and the recursive buffer-aliasing bug.
//
// ScanParams (push constant, matches C++ ScanParamsPush):
//   mode          — 2 (for compatibility with the C++ dispatch logic)
//   data_offset   — offset (in uints) into Data
//   elem_count    — number of elements to process (logical, before offset)
//   block_offset  — offset (in uints) into BlockSums for reading per-block offsets
//
// Bindings:
//   binding 0 — buffer uint[]  Data (read and written in place)
//   binding 1 — readonly buffer uint[]  BlockSums
//
// One Data binding, one BlockSums binding, and they are always distinct buffers: WebGPU forbids
// two storage bindings of one buffer in a dispatch when either is writable, which is why the
// offset addition is expressed as a read-modify-write of a single binding.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define WG_SIZE  256u
#define BLOCK_N  512u   // 2 * WG_SIZE

layout(set = 0, binding = 0) buffer Data {
    uint v[];
} data;

// ---- Per-dispatch constants (push constant, recorded by the caller) ----

layout(push_constant) uniform ScanParamsPush {
    uint mode;
    uint data_offset;
    uint elem_count;
    uint block_offset;
} params;

layout(set = 0, binding = 1) readonly buffer BlockSums {
    uint v[];
} block_sums;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;
    uint n = params.elem_count;
    uint data_off = params.data_offset;

    uint logical_base = wg_id * BLOCK_N;
    uint phys_base = data_off + logical_base;
    uint idx0 = phys_base + tid;
    uint idx1 = phys_base + tid + WG_SIZE;

    uint add_val = block_sums.v[params.block_offset + wg_id];

    if (logical_base + tid < n) {
        data.v[idx0] = data.v[idx0] + add_val;
    }
    if (logical_base + tid + WG_SIZE < n) {
        data.v[idx1] = data.v[idx1] + add_val;
    }
}
