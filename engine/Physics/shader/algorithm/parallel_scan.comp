#version 450 core

// Parallel exclusive prefix sum (Blelloch work-efficient scan).
//
// Each workgroup scans up to 512 elements in shared memory.  For larger
// arrays the C++ side (ParallelScan class) orchestrates a multi-level scan:
//   1. Dispatch with mode=1 (scan blocks + write per-block sums)
//   2. Recursively scan the block-sums buffer (mode=0)
//   3. Dispatch offset-addition shader (mode=2 in add_block_offset.comp)
//
// ScanParams layout (matches C++ ScanParamsGpu):
//   mode          — 0 = single-pass scan, 1 = scan + write block totals
//   data_offset   — offset (in uints) into InputData / OutputData
//   elem_count    — number of elements to process (logical, before offset)
//   block_offset  — offset (in uints) into BlockSums for block-total writes
//
// Bindings:
//   binding 0 — readonly buffer uint[]  InputData
//   binding 1 — buffer uint[]           OutputData (may alias InputData)
//   binding 2 — readonly buffer         ScanParams { mode; data_offset; elem_count; block_offset }
//   binding 3 — buffer uint[]           BlockSums

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define WG_SIZE   256u
#define SHARED_N  512u   // 2 * WG_SIZE — each thread loads 2 elements

layout(set = 0, binding = 0) readonly buffer InputData {
    uint v[];
} input_data;

layout(set = 0, binding = 1) buffer OutputData {
    uint v[];
} output_data;

layout(set = 0, binding = 2) readonly buffer ScanParams {
    uint mode;
    uint data_offset;
    uint elem_count;
    uint block_offset;
} scan_params;

layout(set = 0, binding = 3) buffer BlockSums {
    uint v[];
} block_sums;

shared uint s[SHARED_N];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;
    uint n = scan_params.elem_count;
    uint data_off = scan_params.data_offset;

    // Each workgroup handles SHARED_N elements starting at data_off + wg_id * SHARED_N.
    uint logical_base = wg_id * SHARED_N;
    uint phys_base = data_off + logical_base;
    uint idx0 = phys_base + tid;
    uint idx1 = phys_base + tid + WG_SIZE;

    // Load 2 elements per thread (zero-pad out-of-range).
    s[tid]           = (logical_base + tid < n) ? input_data.v[idx0] : 0u;
    s[tid + WG_SIZE] = (logical_base + tid + WG_SIZE < n) ? input_data.v[idx1] : 0u;
    barrier();

    // --- Upsweep (parallel reduction) ---
    for (uint offset = 1u; offset < SHARED_N; offset <<= 1u) {
        uint idx = (tid + 1u) * offset * 2u - 1u;
        if (idx < SHARED_N) {
            s[idx] += s[idx - offset];
        }
        barrier();
    }

    // Save total sum of this block before clearing the last slot.
    uint block_total = s[SHARED_N - 1u];

    // Convert inclusive → exclusive: clear the last element.
    if (tid == 0u) {
        s[SHARED_N - 1u] = 0u;
    }
    barrier();

    // --- Downsweep (distribution) ---
    for (uint offset = SHARED_N >> 1u; offset > 0u; offset >>= 1u) {
        uint idx = (tid + 1u) * offset * 2u - 1u;
        if (idx < SHARED_N) {
            uint t = s[idx - offset];
            s[idx - offset] = s[idx];
            s[idx] += t;
        }
        barrier();
    }

    // Store results (no add_val — offset addition is done by add_block_offset.comp).
    if (logical_base + tid < n) {
        output_data.v[idx0] = s[tid];
    }
    if (logical_base + tid + WG_SIZE < n) {
        output_data.v[idx1] = s[tid + WG_SIZE];
    }

    // Mode 1: write per-block total sums to BlockSums[block_offset + wg_id].
    if (scan_params.mode == 1u && tid == 0u) {
        block_sums.v[scan_params.block_offset + wg_id] = block_total;
    }
}
