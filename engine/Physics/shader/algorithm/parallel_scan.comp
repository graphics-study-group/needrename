#version 450 core

// Parallel exclusive prefix sum (Blelloch work-efficient scan).
//
// Each workgroup scans up to 512 elements in shared memory.  For larger
// arrays the C++ side (ParallelScan class) orchestrates a multi-level scan:
//   1. Dispatch with mode=1 (scan blocks + write per-block sums)
//   2. Recursively scan the block-sums buffer (mode=0)
//   3. Dispatch with mode=2 (add scanned block offsets back)
//
// Bindings:
//   binding 0 — readonly buffer uint[]  InputData
//   binding 1 — buffer uint[]           OutputData (may alias InputData)
//   binding 2 — readonly buffer         ScanParams { mode; block_offset; elem_count }
//   binding 3 — buffer uint[]           BlockSums

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define WG_SIZE   256u
#define SHARED_N  512u   // 2 * WG_SIZE — each thread loads 2 elements

layout(set = 0, binding = 0) readonly buffer InputData {
    uint v[];
} input_data;

layout(set = 0, binding = 1) buffer OutputData {
    uint v[];
} output_data;

layout(set = 0, binding = 2) readonly buffer ScanParams {
    uint mode;
    uint block_offset;
    uint elem_count;
} scan_params;

layout(set = 0, binding = 3) buffer BlockSums {
    uint v[];
} block_sums;

shared uint s[SHARED_N];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;
    uint n = scan_params.elem_count;

    // Each workgroup handles SHARED_N elements starting at base.
    uint base = wg_id * SHARED_N;
    uint idx0 = base + tid;
    uint idx1 = base + tid + WG_SIZE;

    // Load 2 elements per thread (zero-pad out-of-range).
    s[tid]           = (idx0 < n) ? input_data.v[idx0] : 0u;
    s[tid + WG_SIZE] = (idx1 < n) ? input_data.v[idx1] : 0u;
    barrier();

    // --- Upsweep (parallel reduction) ---
    for (uint offset = 1u; offset < SHARED_N; offset <<= 1u) {
        uint idx = (tid + 1u) * offset * 2u - 1u;
        if (idx < SHARED_N) {
            s[idx] += s[idx - offset];
        }
        barrier();
    }

    // Save total sum of this block before clearing the last slot.
    uint block_total = s[SHARED_N - 1u];

    // Convert inclusive → exclusive: clear the last element.
    if (tid == 0u) {
        s[SHARED_N - 1u] = 0u;
    }
    barrier();

    // --- Downsweep (distribution) ---
    for (uint offset = SHARED_N >> 1u; offset > 0u; offset >>= 1u) {
        uint idx = (tid + 1u) * offset * 2u - 1u;
        if (idx < SHARED_N) {
            uint t = s[idx - offset];
            s[idx - offset] = s[idx];
            s[idx] += t;
        }
        barrier();
    }

    // Mode 2: add per-block offset from the scanned block-sums buffer.
    uint add_val = (scan_params.mode == 2u) ? block_sums.v[wg_id] : 0u;

    // Store results.
    if (idx0 < n) {
        output_data.v[idx0] = s[tid] + add_val;
    }
    if (idx1 < n) {
        output_data.v[idx1] = s[tid + WG_SIZE] + add_val;
    }

    // Mode 1: write per-block total sums for multi-level orchestration.
    if (scan_params.mode == 1u && tid == 0u) {
        block_sums.v[wg_id] = block_total;
    }
}
