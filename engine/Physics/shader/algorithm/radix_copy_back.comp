#version 450 core

// radix_copy_back.comp — Copies a completed sort's result out of the sort's own
// ping-pong arrays and back into the caller's arrays.
//
// A radix pass alternates which of the two arrays it writes, so a call whose
// pass count is odd leaves its result in the instance's arrays. One dispatch of
// this shader moves it back, so after every call the caller's array holds the
// sorted records, whatever the pass count.
//
// Only `[0, count)` is copied: the keys and payloads the sort placed, the count
// being the caller's element-count buffer read at execution time. The dispatch
// covers the whole capacity (`[0, elem_count)`), and an invocation at or beyond
// either bound returns without reading or writing, so an index at or beyond the
// count leaves the caller's arrays exactly as they were.
//
// The keys are always copied; the payloads only when the call supplied one. A
// caller without a payload binds its key arrays as the payload placeholders and
// sets `has_payload` to 0, so neither payload binding is dereferenced.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer SrcKeys {
    uint v[];
} src_keys;

layout(set = 0, binding = 1) writeonly buffer DstKeys {
    uint v[];
} dst_keys;

layout(set = 0, binding = 2) readonly buffer SrcPayload {
    uint v[];
} src_payload;

layout(set = 0, binding = 3) writeonly buffer DstPayload {
    uint v[];
} dst_payload;

// Elements the sort placed, written by an upstream pass in the same frame and
// read here at execution time — never a host constant.
layout(set = 0, binding = 4) readonly buffer ValidCount {
    uint count;
} valid_count;

// ---- Per-dispatch constants (push constant, recorded by the caller) ----

layout(push_constant) uniform CopyBackPush {
    uint elem_count;   // the caller's capacity: the dispatch's element bound
    uint has_payload;  // 1 = copy the payload array too, 0 = keys-only sort
} params;

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.elem_count) return;
    if (idx >= valid_count.count) return;
    dst_keys.v[idx] = src_keys.v[idx];
    if (params.has_payload != 0u) {
        dst_payload.v[idx] = src_payload.v[idx];
    }
}
