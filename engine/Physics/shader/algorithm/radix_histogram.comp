#version 450 core

// Radix sort histogram pass.
//
// Each thread processes one uvec2 pair from the input buffer, extracts an 8-bit
// digit from .x or .y (controlled by params.word_select) at the given byte
// offset (params.byte_shift), and atomically increments the histogram bin.
//
// Dispatch: ceil(elem_capacity / 64), 1, 1
//   elem_capacity is the buffer size (max_pairs), used only to size the dispatch.
//   The actual pair count is read from the PairCount buffer at execution time.
//   Threads with idx >= pair_count.count return immediately.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer PairsIn {
    uvec2 v[];
} pairs_in;

layout(set = 0, binding = 1) buffer Histogram {
    uint v[256];
} histogram;

// ---- Per-dispatch constants (push constant, recorded by the caller) ----

layout(push_constant) uniform RadixParamsPush {
    uint byte_shift;   // 0, 8, 16, or 24
    uint word_select;  // 0 = pair.y (secondary), 1 = pair.x (primary)
} params;

// Actual pair count, written by the pair-generation passes earlier in the frame.
// Read at GPU execution time — NOT a CPU constant baked at RG build time.
layout(set = 0, binding = 2) readonly buffer PairCount {
    uint count;
} pair_count;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Skip threads beyond the actual number of pairs (known only at GPU execution time).
    if (idx >= pair_count.count) return;

    uvec2 pair = pairs_in.v[idx];
    uint key = (params.word_select == 0u) ? pair.y : pair.x;
    uint digit = (key >> params.byte_shift) & 0xFFu;

    atomicAdd(histogram.v[digit], 1u);
}
