#version 450 core
#extension GL_GOOGLE_include_directive : require

// sum_by_key_push.comp — Segmented reduction with a CPU-known entry count.
//
// The value-count form of SumByKey: the host knows the entry count at record
// time, so it travels in the push block and no count buffer is bound.  The
// buffer-count form (sum_by_key.comp) reads a GPU-produced count from its
// `EntryCount` binding instead.  The two are separate shaders rather than one
// with a mode flag, because a variant must not declare a descriptor binding it
// does not bind.
//
// The reduction body, its bindings and its dispatch geometry are documented in
// sum_by_key_body.glsl.
//
// Dispatch: ceil(input_count / 256), 1, 1.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---- Per-dispatch constants (push constant, recorded by the caller) ----
layout(push_constant) uniform SumByKeyPush {
    uint input_count;     // R_i = number of records this level
    uint num_channels;    // N in [1,8]
    uint max_key_value;   // keys >= max_key are ignored (never written to out)
    uint record_stride;   // next region's per-channel count (=2*num_blocks); used when writing records
    uint gather_payload;  // 1 = level 0: gather by payload index, 0 = record arrays
    uint entry_count;     // leading entries carrying real data; bounds gather in level 0 only
} params;

#include "sum_by_key_body.glsl"

void main() {
    SumByKeyRun(
        params.input_count,
        params.num_channels,
        params.max_key_value,
        params.record_stride,
        params.gather_payload,
        params.entry_count
    );
}
