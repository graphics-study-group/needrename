#version 450 core
#extension GL_EXT_debug_printf : enable
#extension GL_GOOGLE_include_directive : require

// GPU convex collision detection using MPR algorithm.
//
// Reads collision pairs from the output of generate_pairs.comp, runs MPR
// detection + perturbation manifold generation for each pair, and writes
// collision results via atomic counter into separate SoA output buffers.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ---- PhysicsScene shape buffers (readonly) ----

layout(set = 0, binding = 0) readonly buffer ShapeAlive {
    uint v[];
} shape_alive;

layout(set = 0, binding = 1) readonly buffer ShapeType {
    uint v[];
} shape_type;

layout(set = 0, binding = 2) readonly buffer ShapeFeature {
    vec4 v[];
} shape_feature;

layout(set = 0, binding = 3) readonly buffer ShapeWorldPosition {
    vec4 v[];
} shape_world_position;

layout(set = 0, binding = 4) readonly buffer ShapeWorldRotation {
    vec4 v[];
} shape_world_rotation;

// ---- Collision pair input (from broad-phase detector) ----

layout(set = 0, binding = 5) readonly buffer CollisionPairs {
    uvec2 v[];
} collision_pairs;

// ---- Pair count (actual number of pairs from broad-phase) ----

layout(set = 0, binding = 13) readonly buffer PairCount {
    uint count;
} pair_count;

// ---- Collision result outputs ----

layout(set = 0, binding = 6) writeonly buffer CollisionIds {
    uvec2 v[];
} collision_ids;

layout(set = 0, binding = 7) writeonly buffer CollisionNormals {
    vec4 v[]; // xyz = normal, w = penetration depth
} collision_normals;

layout(set = 0, binding = 8) writeonly buffer ContactPointA {
    vec4 v[]; // xyz = contact point on A (shape-local), w = 0
} contact_point_a;

layout(set = 0, binding = 9) writeonly buffer ContactPointB {
    vec4 v[]; // xyz = contact point on B (shape-local), w = 0
} contact_point_b;

layout(set = 0, binding = 10) buffer CollisionCount {
    uint v[]; // single-element array, atomically incremented
} collision_count;

// ---- Shape slot count (same buffer used by generate_pairs.comp) ----

layout(set = 0, binding = 11) readonly buffer ShapeSlotCount {
    uint count;
} shape_slot_count;

// ---- Detector config uniform (binding 12) ----

layout(set = 0, binding = 12) uniform DetectorConfig {
    float contact_margin;
} detector_config;

// ---- Shared GLSL headers ----

#include "support.glsl"
#include "mpr.glsl"
#include "perturbation.glsl"

// ---------------------------------------------------------------------------
// Debug printf helper
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Main entry point
// ---------------------------------------------------------------------------

void main() {
    uint pair_index = gl_GlobalInvocationID.x;

    // Early-return if beyond the actual pair count (broad-phase may produce
    // fewer pairs than the dispatch workgroup count).
    if (pair_index >= pair_count.count) {
        return;
    }

    uvec2 pair = collision_pairs.v[pair_index];
    uint shape_a = pair.x;
    uint shape_b = pair.y;

    // Skip if either shape is dead.
    if (shape_a >= shape_alive.v.length() || shape_alive.v[shape_a] == 0u) return;
    if (shape_b >= shape_alive.v.length() || shape_alive.v[shape_b] == 0u) return;

    // Skip self-collision (should not happen with upper-triangle pairs, but
    // guard against corrupted input).
    if (shape_a == shape_b) return;

    // Run MPR collision detection.
    MprResult base_result = mpr_detect(shape_a, shape_b);

    if (!base_result.hit) {
        return; // no collision
    }

    // ---- Contact manifold refinement via perturbation ----
    vec3 midpoint = (base_result.contact_point_a + base_result.contact_point_b) * 0.5;

    PerturbResult pert = perturb_manifold(
        shape_a, shape_b,
        base_result.contact_normal,
        midpoint,
        base_result.penetration,
        detector_config.contact_margin,
        base_result.contact_point_a,
        base_result.contact_point_b
    );

    // Collect output points — each point becomes a separate result entry.
    uint num_points;
    vec3 pts_a[5];
    vec3 pts_b[5];
    float depths[5];

    if (pert.point_count > 0u) {
        num_points = pert.point_count;
        for (uint pi = 0u; pi < pert.point_count; pi++) {
            pts_a[pi] = pert.contact_points_a[pi];
            pts_b[pi] = pert.contact_points_b[pi];
            depths[pi] = pert.penetrations[pi];
        }
    } else {
        // Fall back to MPR single contact point.
        num_points = 1u;
        pts_a[0] = base_result.contact_point_a;
        pts_b[0] = base_result.contact_point_b;
        depths[0] = base_result.penetration;
    }

    // Write each manifold point as a separate result entry.
    // Convert world-space contact points to shape-local space.
    uint write_idx_start = atomicAdd(collision_count.v[0], num_points);
    for (uint pi = 0u; pi < num_points; pi++) {
        uint write_idx = write_idx_start + pi;

        // Guard against buffer overflow.
        if (write_idx >= collision_ids.v.length()) {
            break;
        }

        // Convert world-space contact points to shape-local coordinates.
        vec3 local_pt_a = quat_inv_rotate(shape_world_rotation.v[shape_a], pts_a[pi] - shape_world_position.v[shape_a].xyz);
        vec3 local_pt_b = quat_inv_rotate(shape_world_rotation.v[shape_b], pts_b[pi] - shape_world_position.v[shape_b].xyz);

        collision_ids.v[write_idx]     = uvec2(shape_a, shape_b);
        collision_normals.v[write_idx] = vec4(base_result.contact_normal, depths[pi]);
        contact_point_a.v[write_idx]   = vec4(local_pt_a, 0.0);
        contact_point_b.v[write_idx]   = vec4(local_pt_b, 0.0);
    }
}
