#version 450 core

// Copies a uint[] SSBO from src to dst. One thread per element.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer SrcBuffer {
    uint v[];
} src;

layout(set = 0, binding = 1) writeonly buffer DstBuffer {
    uint v[];
} dst;

// Element count: caller-provided buffer — either a CPU constant (SpatialHash)
// or a GPU-written counter (CompactUnique), so it stays an SSBO.
layout(set = 0, binding = 2) readonly buffer ElemCount {
    uint count;
} elem_count;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= elem_count.count) return;
    dst.v[idx] = src.v[idx];
}
