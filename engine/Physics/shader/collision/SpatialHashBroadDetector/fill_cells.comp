#version 450 core

// Pass 2 of two-pass cell assignment: write (cell_id, shape_index) pairs.
//
// Re-computes the cell range for each non-global alive shape and writes
// (cell_id, shape_index) pairs at the pre-computed offset.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer AabbMin       { vec4 v[]; } aabb_min;
layout(set = 0, binding = 1) readonly buffer AabbMax       { vec4 v[]; } aabb_max;
layout(set = 0, binding = 2) readonly buffer GlobalFlags   { uint v[]; } global_flags;

// --- Config (push constant, recorded by the detector) ---

layout(push_constant) uniform GridPush {
    vec4  world_min_cell_size;  // xyz = bounds min, w = cell_size
    ivec4 grid_dims_max_cells;  // xyz = grid dimensions, w = max_cells_per_shape
    uint  shape_slot_count;
} params;

layout(set = 0, binding = 3) readonly buffer ShapeCellOffset { uint v[]; } shape_cell_offset;

layout(set = 0, binding = 4) writeonly buffer CellShapePairs { uvec2 v[]; } cell_shape_pairs;

// Encode 3D cell coordinate to 1D cell ID.
uint cell_id(ivec3 c) {
    return uint(c.z) * uint(params.grid_dims_max_cells.y * params.grid_dims_max_cells.x)
         + uint(c.y) * uint(params.grid_dims_max_cells.x)
         + uint(c.x);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.shape_slot_count) return;

    if (global_flags.v[idx] != 0u) return;

    vec3 mn = aabb_min.v[idx].xyz;
    vec3 mx = aabb_max.v[idx].xyz;

    float cell_size = params.world_min_cell_size.w;
    vec3 wmin = params.world_min_cell_size.xyz;
    ivec3 dims = params.grid_dims_max_cells.xyz;
    vec3 wmax = wmin + vec3(dims) * cell_size;

    // Skip shapes entirely outside the grid.
    if (any(lessThan(mx, wmin)) || any(greaterThan(mn, wmax))) return;

    ivec3 cmin = ivec3(floor((mn - wmin) / cell_size));
    ivec3 cmax = ivec3(floor((mx - wmin) / cell_size));
    cmin = clamp(cmin, ivec3(0), dims - 1);
    cmax = clamp(cmax, ivec3(0), dims - 1);

    uint base = shape_cell_offset.v[idx];

    for (int z = cmin.z; z <= cmax.z; ++z) {
        for (int y = cmin.y; y <= cmax.y; ++y) {
            for (int x = cmin.x; x <= cmax.x; ++x) {
                uint cid = cell_id(ivec3(x, y, z));
                cell_shape_pairs.v[base] = uvec2(cid, idx);
                base += 1u;
            }
        }
    }
}
