#version 450 core

// Generate collision pairs involving global shapes.
//
// Each workgroup row (gl_WorkGroupID.y) selects one global shape from the
// compact global_list[].  Threads within a row iterate over all alive shapes
// and emit pairs that pass the collision filter.
//
// Dispatch: (ceil(shape_count / 64), global_count, 1)
// Local:    (64, 1, 1)

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0)  readonly buffer GlobalList       { uint v[]; } global_list;
layout(set = 0, binding = 1)  readonly buffer GlobalCount      { uint count; } global_count;
layout(set = 0, binding = 2)  readonly buffer GlobalFlags      { uint v[]; } global_flags;
layout(set = 0, binding = 3)  readonly buffer ShapeAlive       { uint v[]; } shape_alive;
layout(set = 0, binding = 4)  readonly buffer ShapeSlotCount   { uint count; } shape_slot_count;

layout(set = 0, binding = 5)  writeonly buffer CollisionPairs  { uvec2 v[]; } collision_pairs;
layout(set = 0, binding = 6)  buffer PairCount                 { uint v[]; } pair_count;

// Collision filter buffers.
layout(set = 0, binding = 7)  readonly buffer ShapeFilterOffset { uint v[]; } filter_offset;
layout(set = 0, binding = 8)  readonly buffer ShapeFilterCount  { uint v[]; } filter_count;
layout(set = 0, binding = 9)  readonly buffer ShapeFilterData   { uint v[]; } filter_data;

// Binary search: return true if `target` is in filter_data[lo .. lo+cnt-1].
bool is_filtered(uint shape_a, uint shape_b) {
    uint lo = filter_offset.v[shape_a];
    uint hi = lo + filter_count.v[shape_a];
    while (lo < hi) {
        uint mid = (lo + hi) / 2u;
        uint val = filter_data.v[mid];
        if (val == shape_b) return true;
        if (val < shape_b) lo = mid + 1u;
        else hi = mid;
    }
    return false;
}

void main() {
    // Y dimension: select which global shape this workgroup processes.
    uint g_idx = gl_WorkGroupID.y;
    if (g_idx >= global_count.count) return;

    uint g = global_list.v[g_idx];    // actual shape index of this global shape

    // X dimension: select target shape index.
    uint s = gl_WorkGroupID.x * 64u + gl_LocalInvocationID.x;
    uint n = shape_slot_count.count;
    if (s >= n) return;

    // Skip self-collision.
    if (s == g) return;

    // Skip dead target shapes.
    if (shape_alive.v[s] == 0u) return;

    // Deduplicate global×global pairs: only the smaller global index emits.
    if (global_flags.v[s] != 0u && g > s) return;

    // Ensure canonical pair order.
    uint a = min(g, s);
    uint b = max(g, s);

    // Skip filtered pairs.
    if (is_filtered(a, b)) return;

    uint slot = atomicAdd(pair_count.v[0], 1u);
    collision_pairs.v[slot] = uvec2(a, b);
}
