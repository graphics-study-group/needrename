#version 450 core

// Writes zero to every element of a uint[] SSBO.
// Used to clear cell histograms and other atomic-accumulation buffers.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Target {
    uint v[];
} target;

// ---- Per-dispatch constants (push constant, recorded by the caller) ----

layout(push_constant) uniform ElemCountPush {
    uint elem_count;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.elem_count) return;
    target.v[idx] = 0u;
}
