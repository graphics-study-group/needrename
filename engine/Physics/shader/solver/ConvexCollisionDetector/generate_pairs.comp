#version 450 core

// GPU-side all-pairs collision pair generation.
//
// Each thread computes one upper-triangle pair (i, j) with i < j from its
// global invocation ID and writes it to the output buffer.  Threads beyond
// N*(N-1)/2 early-return (write nothing).
//
// The pair buffer is consumed by detect_collisions.comp.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Number of shape slots (including dead slots).  Provided as a single-uint
// uniform buffer so the host can update it without rebuilding the pipeline.
layout(set = 0, binding = 0) readonly buffer ShapeSlotCount {
    uint count;
} shape_slot_count;

// Output: array of uvec2 collision pairs.  Sized to max_collision_pairs.
layout(set = 0, binding = 1) writeonly buffer CollisionPairs {
    uvec2 v[];
} collision_pairs;

// Collision count buffer — reset to 0 by this pass before the detection pass.
// Thread 0 writes 0; all other threads leave it untouched.
layout(set = 0, binding = 2) buffer CollisionCount {
    uint v[];
} collision_count;

void main() {
    uint k = gl_GlobalInvocationID.x;

    // Thread 0 resets the collision count.
    if (k == 0u) {
        collision_count.v[0] = 0u;
    }

    uint n = shape_slot_count.count;

    // Total number of upper-triangle pairs: N*(N-1)/2.
    // Compute this safely to avoid overflow.
    uint total_pairs = (n * (n - 1u)) / 2u;

    if (k >= total_pairs) {
        return; // beyond valid range — write nothing
    }

    // Map linear index k to upper-triangle pair (i, j) with i < j.
    //
    // Row i (0-indexed) contains (N - i - 1) pairs:
    //   i=0: (0,1), (0,2), ..., (0, N-1)   → N-1 pairs
    //   i=1: (1,2), (1,3), ..., (1, N-1)   → N-2 pairs
    //   ...
    //
    // Accumulate until remaining < row_size.
    uint i = 0u;
    uint remaining = k;
    uint row_size = n - 1u; // pairs in row 0

    while (remaining >= row_size && row_size > 0u) {
        remaining -= row_size;
        i += 1u;
        row_size = n - i - 1u;
    }

    uint j = i + 1u + remaining;

    collision_pairs.v[k] = uvec2(i, j);
}
