#version 450 core
#extension GL_GOOGLE_include_directive : require

// accumulate_contact_velocity.comp — Per-contact velocity-level XPBD:
// restitution (normal) + kinetic friction (tangent), Jacobi accumulate.
//
// Velocity shares the SAME contact topology as the position solve: the contact
// entry list was built and sorted once for this substep, and velocity
// iterations reuse that sorted (key, slot) list.  Each contribution is
// scattered into the shared contact value buffer at its own slot index; the
// value buffer is cleared before every velocity iteration, so a contact that
// does not contribute writes nothing.
//
// The normal and the tangential part are two SEPARATE constraint directions:
// w(d) varies with direction through |r x d|^2 = |r|^2 - (r . d)^2, so each is
// converted from its velocity target with its own inverse effective mass.  The
// Coulomb cap is expressed in impulse space and applied to the total this
// contact has been given so far this substep (ContactTangentImpulse), which is
// a vector and is kept inside the cone by projection.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common/xpbd_math.glsl"
#include "common/xpbd_entry_layout.glsl"

// ---- Collision buffers ----
layout(set = 0, binding = 0)  readonly buffer CollisionIds       { uvec2 v[]; } collision_ids;
// One record per contact: the normal with its depth and the contact point on each shape. Read for
// the same index as a unit, so it is one binding rather than three.
struct ContactGeometry {
    vec4 normal;
    vec4 point_a;
    vec4 point_b;
};
layout(set = 0, binding = 1)  readonly buffer ContactGeometries { ContactGeometry v[]; } contact_geometry;
layout(set = 0, binding = 4)  readonly buffer CollisionCount     { uint count; } collision_count;

// ---- Body state ----
layout(set = 0, binding = 6)  readonly buffer RigidBodyAlive          { uint v[];  } rigid_body_alive;
layout(set = 0, binding = 7)  readonly buffer RigidBodyCenterRotation  { vec4 v[];  } rigid_body_center_rotation;
layout(set = 0, binding = 8)  buffer      RigidBodyLinearVelocity      { vec4 v[];  } rigid_body_linear_velocity;
layout(set = 0, binding = 9)  buffer      RigidBodyAngularVelocity     { vec4 v[];  } rigid_body_angular_velocity;
layout(set = 0, binding = 10) readonly buffer RigidBodyMass             { float v[]; } rigid_body_mass;
layout(set = 0, binding = 11) readonly buffer RigidBodyInverseInertia   { mat4 v[];  } rigid_body_inverse_inertia;
// A body's two friction coefficients, read together for the same index: one record, one binding.
struct BodyMaterial {
    float dynamic_friction;
    float restitution;
};
layout(set = 0, binding = 12) readonly buffer RigidBodyMaterials { BodyMaterial v[]; } rigid_body_material;
layout(set = 0, binding = 14) readonly buffer RigidBodyIsKinematic      { uint v[];  } rigid_body_is_kinematic;

// ---- Pre-contact snapshots ----
layout(set = 0, binding = 15) readonly buffer PreContactLinearVelocity  { vec4 v[]; } pre_contact_linear_vel;
layout(set = 0, binding = 16) readonly buffer PreContactAngularVelocity { vec4 v[]; } pre_contact_angular_vel;

// ---- Shape local transforms ----
// One record per shape: a local transform is a position and a rotation read together for the same
// index, so they are one binding rather than two. See 	asks.md / the binding budget in the WebGPU
// backend: a browser caps storage buffers at 16 per stage.
struct ShapeLocalTransform { vec4 position; vec4 rotation; uvec4 bound_body; };
layout(set = 0, binding = 17) readonly buffer ShapeLocalTransforms { ShapeLocalTransform v[]; } shape_local;

// ---- Lagrange (readonly) ----
// Per-contact solver state: the normal multiplier and the kinetic friction impulse. Both are
// accumulated for the same contact index across the substep, so they are one record and one
// binding. `tangent_lagrange` is the position phase's field and is not read here, but the record is
// shared with that phase so the two accumulators keep one layout.
struct ContactImpulse {
    float lagrange;
    vec4 tangent_impulse;
    vec4 tangent_lagrange;
};
layout(set = 0, binding = 19) buffer ContactImpulses { ContactImpulse v[]; } contact_impulse;

// Channel-major value buffer: the real per-entry contribution values,
// indexed by entry slot. Used in "xpbd_scatter.glsl"
layout(set = 0, binding = 21) buffer Values { float v[]; } values;

#include "common/xpbd_scatter.glsl"

// ---- Per-dispatch constants (push constant, recorded by the solver) ----
layout(push_constant) uniform XpbdPush {
    vec4 gravity_dt;       // w = substep_dt
    uint entry_capacity;   // number of contact entry slots (== 2 * max_contact_point)
} params;

// Inverse effective mass w(d) of the contact along the unit direction `d`:
//   inv_mass_a + inv_mass_b
//     + dot(I_inv_a * (r_a x d), r_a x d)
//     + dot(I_inv_b * (r_b x d), r_b x d)
// A kinematic body is immovable: its inverse mass is zero and its inverse
// inertia contributes nothing, whatever it was authored with.
float inv_effective_mass(
    vec3 d,
    float inv_mass_a,
    float inv_mass_b,
    mat4 inv_inertia_a,
    mat4 inv_inertia_b,
    vec4 ori_a,
    vec4 ori_b,
    vec3 r_a,
    vec3 r_b,
    bool kinematic_a,
    bool kinematic_b
) {
    float w = inv_mass_a + inv_mass_b;

    if (!kinematic_a) {
        vec3 r_a_d = cross(r_a, d);
        w += dot(apply_world_inv_inertia(inv_inertia_a, ori_a, r_a_d), r_a_d);
    }
    if (!kinematic_b) {
        vec3 r_b_d = cross(r_b, d);
        w += dot(apply_world_inv_inertia(inv_inertia_b, ori_b, r_b_d), r_b_d);
    }

    return w;
}

void main() {
    uint cidx = gl_GlobalInvocationID.x;
    if (cidx >= collision_count.count) return;
    // The per-contact multiplier buffers are sized to the contact-point
    // capacity (entry_capacity / 2, two entry slots per contact point).
    if (cidx >= params.entry_capacity / 2u) return;

    uvec2 pair = collision_ids.v[cidx];
    uint shape_a = pair.x, shape_b = pair.y;
    if (shape_a >= shape_local.v.length() || shape_b >= shape_local.v.length()) return;

    uint body_a = shape_local.v[shape_a].bound_body.x;
    uint body_b = shape_local.v[shape_b].bound_body.x;
    uint body_count = rigid_body_alive.v.length();
    if (body_a >= body_count || body_b >= body_count) return;
    if (rigid_body_alive.v[body_a] == 0u || rigid_body_alive.v[body_b] == 0u) return;

    const uint slot_a = contact_slot(cidx, 0u);
    const uint slot_b = contact_slot(cidx, 1u);

    bool kinematic_a = (rigid_body_is_kinematic.v[body_a] != 0u);
    bool kinematic_b = (rigid_body_is_kinematic.v[body_b] != 0u);
    if (kinematic_a && kinematic_b) return;

    float inv_mass_a = (!kinematic_a && rigid_body_mass.v[body_a] > 1e-12) ? (1.0 / rigid_body_mass.v[body_a]) : 0.0;
    float inv_mass_b = (!kinematic_b && rigid_body_mass.v[body_b] > 1e-12) ? (1.0 / rigid_body_mass.v[body_b]) : 0.0;
    if (inv_mass_a <= 0.0 && inv_mass_b <= 0.0) return;

    vec3 n = contact_geometry.v[cidx].normal.xyz;
    float nlen = length(n);
    if (nlen < 1e-8) return;
    n /= nlen;

    // Shape-local contact points from collision detection.
    vec3 local_pt_a = contact_geometry.v[cidx].point_a.xyz;
    vec3 local_pt_b = contact_geometry.v[cidx].point_b.xyz;

    // Current body orientations.
    vec4 ori_a = rigid_body_center_rotation.v[body_a];
    vec4 ori_b = rigid_body_center_rotation.v[body_b];

    // Shape local offsets.
    vec3 shape_local_pos_a = shape_local.v[shape_a].position.xyz;
    vec3 shape_local_pos_b = shape_local.v[shape_b].position.xyz;
    vec4 shape_local_rot_a = shape_local.v[shape_a].rotation;
    vec4 shape_local_rot_b = shape_local.v[shape_b].rotation;

    // Compute lever arms from shape-local coords + current body pose.
    // (body position cancels out: r = world_pt - body_pos = quat_rotate(ori, local_in_body))
    vec3 local_in_body_a = quat_rotate(shape_local_rot_a, local_pt_a) + shape_local_pos_a;
    vec3 local_in_body_b = quat_rotate(shape_local_rot_b, local_pt_b) + shape_local_pos_b;
    vec3 r_a = quat_rotate(ori_a, local_in_body_a);
    vec3 r_b = quat_rotate(ori_b, local_in_body_b);

    // Current contact-point velocity.
    vec3 v_a = rigid_body_linear_velocity.v[body_a].xyz;
    vec3 v_b = rigid_body_linear_velocity.v[body_b].xyz;
    vec3 w_a = rigid_body_angular_velocity.v[body_a].xyz;
    vec3 w_b = rigid_body_angular_velocity.v[body_b].xyz;

    vec3 contact_vel_a = v_a + cross(w_a, r_a);
    vec3 contact_vel_b = v_b + cross(w_b, r_b);
    vec3 rel_vel = contact_vel_a - contact_vel_b;

    // Previous contact-point velocity (for restitution reference).
    vec3 pre_v_a = pre_contact_linear_vel.v[body_a].xyz;
    vec3 pre_v_b = pre_contact_linear_vel.v[body_b].xyz;
    vec3 pre_w_a = pre_contact_angular_vel.v[body_a].xyz;
    vec3 pre_w_b = pre_contact_angular_vel.v[body_b].xyz;

    vec3 pre_contact_vel_a = pre_v_a + cross(pre_w_a, r_a);
    vec3 pre_contact_vel_b = pre_v_b + cross(pre_w_b, r_b);
    vec3 pre_rel_vel = pre_contact_vel_a - pre_contact_vel_b;

    float vn      = dot(n, rel_vel);
    float vn_prev = dot(n, pre_rel_vel);

    mat4 inv_inertia_a = rigid_body_inverse_inertia.v[body_a];
    mat4 inv_inertia_b = rigid_body_inverse_inertia.v[body_b];

    // The position phase's accumulated normal multiplier: positive exactly for
    // the contacts it actually solved.
    float normal_lagrange = contact_impulse.v[cidx].lagrange;
    vec3 impulse = vec3(0.0);

    // ---- Normal part: restitution, converted with its own effective mass ----
    // Applied only where the position phase solved the contact.
    if (normal_lagrange > 0.0) {
        float w_n = inv_effective_mass(
            n, inv_mass_a, inv_mass_b, inv_inertia_a, inv_inertia_b, ori_a, ori_b, r_a, r_b, kinematic_a, kinematic_b
        );
        if (w_n <= 1e-8) return;

        float restitution = rigid_body_material.v[body_a].restitution * rigid_body_material.v[body_b].restitution;
        float normal_delta_v = -vn + min(-restitution * vn_prev, 0.0);
        impulse = (normal_delta_v / w_n) * n;
    }

    // ---- Tangential (kinetic friction) part ----
    // Applied unconditionally for every contact the position phase solved: for a
    // sticking contact the wanted total below equals what the contact already
    // holds, so the correction is zero; for a sliding contact it delivers up to
    // the full kinetic bound.
    vec3 tangent_vel = rel_vel - vn * n;
    float tangent_speed = length(tangent_vel);
    float dt = params.gravity_dt.w;
    if (tangent_speed > 1e-8 && dt > 1e-8) {
        vec3 t = tangent_vel / tangent_speed;
        float w_t = inv_effective_mass(
            t, inv_mass_a, inv_mass_b, inv_inertia_a, inv_inertia_b, ori_a, ori_b, r_a, r_b, kinematic_a, kinematic_b
        );
        if (w_t > 1e-8) {
            float friction_coef = 0.5 * (
                rigid_body_material.v[body_a].dynamic_friction + rigid_body_material.v[body_b].dynamic_friction
            );
            // lambda_n / dt is an impulse; the Coulomb bound bounds an impulse.
            float normal_impulse_mag = abs(normal_lagrange) / dt;
            float friction_cap = normal_impulse_mag * friction_coef;
            vec3 friction_used = contact_impulse.v[cidx].tangent_impulse.xyz;
            vec3 friction_ideal = friction_used - (tangent_speed / w_t) * t;
            float ideal_len = length(friction_ideal);
            vec3 friction_new =
                (ideal_len > friction_cap) ? friction_ideal * (friction_cap / ideal_len) : friction_ideal;
            vec3 friction_delta = friction_new - friction_used;
            if (length(friction_delta) > 1e-8) {
                impulse += friction_delta;
                contact_impulse.v[cidx].tangent_impulse.xyz = friction_new;
            }
        }
    }

    if (length(impulse) <= 1e-8) return;

    // Scatter for body A.
    if (!kinematic_a && inv_mass_a > 0.0) {
        vec3 ld = inv_mass_a * impulse;
        vec3 ad = apply_world_inv_inertia(inv_inertia_a, ori_a, cross(r_a, impulse));
        scatter_slot(slot_a, params.entry_capacity, ld, ad);
    }

    // Scatter for body B.
    if (!kinematic_b && inv_mass_b > 0.0) {
        vec3 ld = -inv_mass_b * impulse;
        vec3 ad = apply_world_inv_inertia(inv_inertia_b, ori_b, cross(r_b, impulse));
        scatter_slot(slot_b, params.entry_capacity, ld, -ad);
    }
}
