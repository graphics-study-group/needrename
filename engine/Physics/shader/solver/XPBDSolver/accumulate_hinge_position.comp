#version 450 core
#extension GL_GOOGLE_include_directive : require

// accumulate_hinge_position.comp — Per-hinge XPBD position constraint for one
// graph color, as a direct pose write.
//
// Solves two constraints per hinge:
//   1. Aligned axis: cross(axis1_world, axis2_world) → 0
//   2. Attachment point: attach_point2_world - attach_point1_world → 0
//
// Joints in one color share no bodies, so each invocation is the only writer of
// its two bodies and can add the full correction to their poses directly. No
// value buffer, contribution count, segmented reduction or apply pass is
// involved, and nothing divides the correction by the number of constraints on
// a body. See common/xpbd_joint_solve.glsl for the shared evaluation.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common/xpbd_math.glsl"
#include "common/xpbd_joint_math.glsl"

// ---- Joint definition buffer (PhysicsScene-owned, read-only) ----
struct HingeJointComDescriptor {
    uint obj1_index;
    uint obj2_index;
    float compliance;
    float _pad;
    vec4 hinge_axis_obj1;
    vec4 hinge_anchor_obj1;
    vec4 initial_rel_pos_local;
    vec4 initial_rel_rotation;
};

layout(set = 0, binding = 0) readonly buffer HingeJoints { HingeJointComDescriptor v[]; } hinge_joints;

// ---- Lagrange multiplier SoA buffers (solver-owned, read-write) ----
layout(set = 0, binding = 1) buffer HingeAxisLagrange   { float v[]; } hinge_axis_lagrange;
layout(set = 0, binding = 2) buffer HingeAnchorLagrange { float v[]; } hinge_anchor_lagrange;
layout(set = 0, binding = 3) readonly buffer HingeJointAlive { uint v[]; } hinge_joint_alive;

// ---- Body state. Position and rotation are read-write: this pass applies the
// joint's correction to them. ----
layout(set = 0, binding = 4) readonly buffer RigidBodyAlive          { uint v[]; } rigid_body_alive;
layout(set = 0, binding = 5) buffer          RigidBodyCenterPosition { vec4 v[]; } rigid_body_center_position;
layout(set = 0, binding = 6) buffer          RigidBodyCenterRotation { vec4 v[]; } rigid_body_center_rotation;
layout(set = 0, binding = 7) readonly buffer RigidBodyMass           { float v[]; } rigid_body_mass;
layout(set = 0, binding = 8) readonly buffer RigidBodyInverseInertia { mat4 v[]; } rigid_body_inverse_inertia;
layout(set = 0, binding = 9) readonly buffer RigidBodyIsKinematic    { uint v[]; } rigid_body_is_kinematic;

#define XPBD_JOINT_SOLVE_HINGE
#include "common/xpbd_joint_solve.glsl"

// ---- This color's slice of the bucket index list ----
layout(set = 0, binding = 10) readonly buffer JointColorIds { uint v[]; } joint_color_ids;

// ---- Per-dispatch constants (push constant, recorded by the solver) ----
layout(push_constant) uniform XpbdPush {
    vec4 gravity_dt;      // w = substep_dt
    uint color_count;     // joints in this color
    uint color_offset;    // first index of this color's slice in JointColorIds
    uint joint_capacity;  // joint descriptor slot count
} params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.color_count) return;
    uint jidx = joint_color_ids.v[params.color_offset + i];
    if (jidx >= params.joint_capacity) return;

    joint_solve_hinge(jidx, params.gravity_dt.w);
}
