#version 450 core
#extension GL_GOOGLE_include_directive : require

// apply_body_position_deltas.comp — Per-body Jacobi apply phase for
// position constraints.  Averages the accumulated deltas and applies
// them to body positions and orientations, then resets accumulators.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common/xpbd_math.glsl"

// ---- Buffers ----
layout(set = 0, binding = 0) readonly buffer RigidBodyAlive       { uint v[]; } rigid_body_alive;
layout(set = 0, binding = 1) buffer      RigidBodyCenterPosition  { vec4 v[]; } rigid_body_center_position;
layout(set = 0, binding = 2) buffer      RigidBodyCenterRotation  { vec4 v[]; } rigid_body_center_rotation;
layout(set = 0, binding = 3) readonly buffer RigidBodyIsKinematic    { uint v[]; } rigid_body_is_kinematic;

layout(set = 0, binding = 4) buffer LinearPositionDelta  { float v[]; } linear_delta_i;
layout(set = 0, binding = 5) buffer AngularPositionDelta { float v[]; } angular_delta_i;
layout(set = 0, binding = 6) buffer PositionDeltaCount    { float v[]; } delta_count;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= rigid_body_alive.v.length()) return;
    if (rigid_body_alive.v[idx] == 0u) return;
    if (rigid_body_is_kinematic.v[idx] != 0u) return;

    float count = delta_count.v[idx];
    if (count <= 0.0) return;
    float inv_count = 1.0 / count;

    vec3 linear_delta;
    linear_delta.x = linear_delta_i.v[idx * 3u + 0u] * inv_count;
    linear_delta.y = linear_delta_i.v[idx * 3u + 1u] * inv_count;
    linear_delta.z = linear_delta_i.v[idx * 3u + 2u] * inv_count;

    vec3 angular_delta;
    angular_delta.x = angular_delta_i.v[idx * 3u + 0u] * inv_count;
    angular_delta.y = angular_delta_i.v[idx * 3u + 1u] * inv_count;
    angular_delta.z = angular_delta_i.v[idx * 3u + 2u] * inv_count;

    // Apply linear delta.
    rigid_body_center_position.v[idx].xyz += linear_delta;

    // Apply angular delta as quaternion update: q += 0.5 * Quat(w_delta, 0) * q
    float angular_norm = length(angular_delta);
    if (angular_norm > 1e-8) {
        vec4 orientation = rigid_body_center_rotation.v[idx];
        vec4 q_update = vec4(angular_delta, 0.0);
        orientation += 0.5 * quat_mul(q_update, orientation);
        orientation = quat_normalize(orientation);
        rigid_body_center_rotation.v[idx] = orientation;
    }

    // Reset accumulators to zero.
    linear_delta_i.v[idx * 3u + 0u] = 0.0;
    linear_delta_i.v[idx * 3u + 1u] = 0.0;
    linear_delta_i.v[idx * 3u + 2u] = 0.0;
    angular_delta_i.v[idx * 3u + 0u] = 0.0;
    angular_delta_i.v[idx * 3u + 1u] = 0.0;
    angular_delta_i.v[idx * 3u + 2u] = 0.0;
    delta_count.v[idx] = 0.0;
}
