#version 450 core
#extension GL_GOOGLE_include_directive : require

// apply_body_position_deltas.comp — Per-body Jacobi apply for contacts.
//
// SumByKey reduced the contact group's per-entry contributions into a per-body
// partial set in a channel-major buffer with stride == body_count:
//     out(c, body) = out[c * body_count + body],  c in 0..6
//   (channels: Δlin 0..2, Δang 3..5, flag 6)
//
// This pass averages the contact partials by the contact contribution count,
// applies them, then clears the seven cells for this body so stale data can
// never pollute a later iteration. Kinematic / dead bodies are never written by
// SumByKey but their cells are still kept zeroed.
//
// Joints do not pass through here. A joint color pass writes both of its
// bodies' poses directly (see common/xpbd_joint_solve.glsl), so this pass owns
// the contact group alone and no hinge or fixed partial set exists.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common/xpbd_math.glsl"
#include "common/xpbd_entry_layout.glsl"

layout(set = 0, binding = 0) readonly buffer RigidBodyAlive       { uint v[]; } rigid_body_alive;
layout(set = 0, binding = 1) buffer      RigidBodyCenterPosition  { vec4 v[]; } rigid_body_center_position;
layout(set = 0, binding = 2) buffer      RigidBodyCenterRotation  { vec4 v[]; } rigid_body_center_rotation;
layout(set = 0, binding = 3) readonly buffer RigidBodyIsKinematic { uint v[]; } rigid_body_is_kinematic;

// Per-body contact partial set (channel-major, stride = body_count).
layout(set = 0, binding = 4) buffer ContactOut { float v[]; } contact_out;

layout(push_constant) uniform BodyCountPush {
    uint body_count_val;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.body_count_val) return;
    if (rigid_body_alive.v[idx] == 0u) return;

    if (rigid_body_is_kinematic.v[idx] != 0u) {
        for (uint c = 0u; c < kNumValueChannels; ++c) {
            contact_out.v[c * params.body_count_val + idx] = 0.0f;
        }
        return;
    }

    vec3 lin_sum = vec3(0.0);
    vec3 ang_sum = vec3(0.0);
    float count = 0.0f;

    lin_sum.x += contact_out.v[0u * params.body_count_val + idx];
    lin_sum.y += contact_out.v[1u * params.body_count_val + idx];
    lin_sum.z += contact_out.v[2u * params.body_count_val + idx];
    ang_sum.x += contact_out.v[3u * params.body_count_val + idx];
    ang_sum.y += contact_out.v[4u * params.body_count_val + idx];
    ang_sum.z += contact_out.v[5u * params.body_count_val + idx];
    count     += contact_out.v[6u * params.body_count_val + idx];

    // Clear the partial set for this body (consumed).
    for (uint c = 0u; c < kNumValueChannels; ++c) {
        contact_out.v[c * params.body_count_val + idx] = 0.0f;
    }

    if (count <= 0.0f) return;
    float inv_count = 1.0f / count;

    rigid_body_center_position.v[idx].xyz += lin_sum * inv_count;

    float angular_norm = length(ang_sum);
    if (angular_norm > 1e-8) {
        vec4 orientation = rigid_body_center_rotation.v[idx];
        vec4 q_update = vec4(ang_sum * inv_count, 0.0);
        orientation += 0.5 * quat_mul(q_update, orientation);
        orientation = quat_normalize(orientation);
        rigid_body_center_rotation.v[idx] = orientation;
    }
}
