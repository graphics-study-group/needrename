#version 450 core
#extension GL_GOOGLE_include_directive : require

// apply_body_velocity_deltas.comp — Per-body Jacobi apply for velocity
// constraints.  Only contacts produce velocity corrections; SumByKey reduced
// the contact velocity scratch into a per-body set in a channel-major buffer
// with stride == body_count: vel_out(c, body) = vel_out[c*body_count + body]
// (channels: Δlin 0..2, Δang 3..5, flag 6).  Averages by the flag count,
// applies, and clears the set for this body so stale cells cannot leak into a
// later velocity iteration.  Kinematic / dead bodies are never written by
// SumByKey, but we still keep their cells zeroed.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common/xpbd_entry_layout.glsl"

layout(set = 0, binding = 0) readonly buffer RigidBodyAlive        { uint v[]; } rigid_body_alive;
layout(set = 0, binding = 1) buffer      RigidBodyLinearVelocity   { vec4 v[]; } rigid_body_linear_velocity;
layout(set = 0, binding = 2) buffer      RigidBodyAngularVelocity  { vec4 v[]; } rigid_body_angular_velocity;
layout(set = 0, binding = 3) readonly buffer RigidBodyIsKinematic     { uint v[]; } rigid_body_is_kinematic;

layout(set = 0, binding = 4) buffer VelOut { float v[]; } vel_out;

layout(push_constant) uniform BodyCountPush {
    uint body_count_val;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.body_count_val) return;
    if (rigid_body_alive.v[idx] == 0u) return;

    if (rigid_body_is_kinematic.v[idx] != 0u) {
        for (uint c = 0u; c < kNumValueChannels; ++c) {
            vel_out.v[c * params.body_count_val + idx] = 0.0f;
        }
        return;
    }

    vec3 lin = vec3(
        vel_out.v[0u * params.body_count_val + idx],
        vel_out.v[1u * params.body_count_val + idx],
        vel_out.v[2u * params.body_count_val + idx]
    );
    vec3 ang = vec3(
        vel_out.v[3u * params.body_count_val + idx],
        vel_out.v[4u * params.body_count_val + idx],
        vel_out.v[5u * params.body_count_val + idx]
    );
    float count = vel_out.v[6u * params.body_count_val + idx];

    for (uint c = 0u; c < kNumValueChannels; ++c) {
        vel_out.v[c * params.body_count_val + idx] = 0.0f;
    }

    if (count <= 0.0f) return;
    float inv_count = 1.0f / count;
    rigid_body_linear_velocity.v[idx].xyz += lin * inv_count;
    rigid_body_angular_velocity.v[idx].xyz += ang * inv_count;
}
