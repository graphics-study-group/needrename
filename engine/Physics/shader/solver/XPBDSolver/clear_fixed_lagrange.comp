#version 450 core
#extension GL_GOOGLE_include_directive : require

// clear_fixed_lagrange.comp — Zero fixed joint Lagrange multiplier SoA buffers
// before each substep position iteration loop.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer FixedRotationLagrange { float v[]; } fixed_rotation_lagrange;
layout(set = 0, binding = 1) buffer FixedPositionLagrange  { float v[]; } fixed_position_lagrange;

// ---- Per-dispatch constants (push constant, recorded by the solver) ----
layout(push_constant) uniform JointCountPush {
    uint joint_count;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.joint_count) return;

    fixed_rotation_lagrange.v[idx] = 0.0;
    fixed_position_lagrange.v[idx] = 0.0;
}
