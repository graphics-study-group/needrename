#version 450 core
#extension GL_GOOGLE_include_directive : require

// clear_hinge_lagrange.comp — Zero hinge joint Lagrange multiplier SoA buffers
// before each substep position iteration loop.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer HingeAxisLagrange   { float v[]; } hinge_axis_lagrange;
layout(set = 0, binding = 1) buffer HingeAnchorLagrange { float v[]; } hinge_anchor_lagrange;

// ---- Per-dispatch constants (push constant, recorded by the solver) ----
layout(push_constant) uniform JointCountPush {
    uint joint_count;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.joint_count) return;

    hinge_axis_lagrange.v[idx] = 0.0;
    hinge_anchor_lagrange.v[idx] = 0.0;
}
