#version 450 core

// clear_int_buffer.comp — Writes zero to every element of an int[] SSBO.
// Used for resetting lagrange multipliers and other integer accumulators.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Target {
    int v[];
} target;

// ---- Per-dispatch constants (push constant, recorded by the solver) ----

layout(push_constant) uniform ElemCountPush {
    uint elem_count;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.elem_count) return;
    target.v[idx] = 0;
}
