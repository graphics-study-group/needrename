#version 450 core
#extension GL_GOOGLE_include_directive : require

// hinge_entries.comp — Hinge entry-list construction (once per substep, before
// the radix sort).
//
// Dispatched over the hinge entry capacity (4 slots per joint = 2 bodies x 2
// scalar constraints: the aligned-axis constraint and the anchor-point
// constraint), one invocation per joint.
//
// CONTRACT: every slot in [0, capacity) is written on every dispatch, and this
// shader never returns before writing.  A slot's key encodes *ownership* only:
// the index of the body the slot belongs to, or `body_count` when the joint does
// not exist this substep or an owner index is out of range.  `body_count` is
// larger than every real key, so unowned slots sort after every owned one (the
// entry count stays a prefix of the sorted order) and SumByKey drops them,
// because the solver passes `body_count` as its `max_key_value`.  No body or
// joint state (alive / kinematic / mass) is read here — whether a body actually
// receives a contribution is decided by accumulate_hinge_position.comp, and an
// unwritten slot stays inert because the value buffer is cleared before every
// iteration.
//
// CONTRACT: the payload array carries each slot's own id, and it must be written
// on **every** dispatch, not only when the entry list changes.  The radix sort
// permutes the payload array in place, so a substep that skipped rewriting it
// would gather values for the previous substep's permutation.  That is the one
// mistake in this adaptation that would fail silently.
//
// Channel/slot conventions: common/xpbd_entry_layout.glsl.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "../common/xpbd_entry_layout.glsl"

// ---- Joint definition buffer (PhysicsScene-owned, read-only) ----
struct HingeJointComDescriptor {
    uint obj1_index;
    uint obj2_index;
    float compliance;
    float _pad;
    vec4 hinge_axis_obj1;
    vec4 hinge_anchor_obj1;
    vec4 initial_rel_pos_local;
    vec4 initial_rel_rotation;
};

layout(set = 0, binding = 0) readonly buffer HingeJoints { HingeJointComDescriptor v[]; } hinge_joints;

// ---- Body count bound (only `.length()` is used) ----
layout(set = 0, binding = 1) readonly buffer RigidBodyAlive { uint v[]; } rigid_body_alive;

// ---- Output: the entry key array and its payload (slot id) array ----
layout(set = 0, binding = 2) buffer EntryKeys    { uint v[]; } entry_keys;
layout(set = 0, binding = 3) buffer EntryPayload { uint v[]; } entry_payload;

// ---- Per-dispatch constants (push constant, recorded by the solver) ----
layout(push_constant) uniform JointCountPush {
    uint joint_count;
    uint entry_capacity;   // number of hinge entry slots (== 4 * hinge joint capacity)
} params;

void main() {
    uint j = gl_GlobalInvocationID.x;

    const uint slot1_axis   = joint_slot(j, 0u, kJointAxisSlot);
    const uint slot1_anchor = joint_slot(j, 0u, kJointAnchorSlot);
    const uint slot2_axis   = joint_slot(j, 1u, kJointAxisSlot);
    const uint slot2_anchor = joint_slot(j, 1u, kJointAnchorSlot);
    // The dispatch rounds up to whole workgroups, so the last workgroup can run
    // past the end of the entry list.  Threads past the capacity own no slots.
    if (slot2_anchor >= params.entry_capacity) return;

    // The invalid-slot key is the body count: the largest key this substep can
    // produce, and the value SumByKey is told to drop.
    const uint body_count = rigid_body_alive.v.length();
    uint key1 = body_count;
    uint key2 = body_count;

    if (j < params.joint_count) {
        HingeJointComDescriptor constraint = hinge_joints.v[j];
        if (constraint.obj1_index < body_count) key1 = constraint.obj1_index;
        if (constraint.obj2_index < body_count) key2 = constraint.obj2_index;
    }

    // A constraint only ever contributes to a body when that body is movable,
    // so both constraints of a body share its key.
    entry_keys.v[slot1_axis]   = key1;
    entry_keys.v[slot1_anchor] = key1;
    entry_keys.v[slot2_axis]   = key2;
    entry_keys.v[slot2_anchor] = key2;
    // The payload is the slot's own id, and it is rewritten every dispatch
    // because the sort permutes it in place.
    entry_payload.v[slot1_axis]   = slot1_axis;
    entry_payload.v[slot1_anchor] = slot1_anchor;
    entry_payload.v[slot2_axis]   = slot2_axis;
    entry_payload.v[slot2_anchor] = slot2_anchor;
}
