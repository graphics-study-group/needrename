#define ENGINE_ROOT_DIR "@ENGINE_ROOT_DIR@"
#define ENGINE_SOURCE_DIR "@ENGINE_SOURCE_DIR@"
#define ENGINE_ASSETS_DIR "@ASSETS_DIR@"
#define ENGINE_BUILTIN_ASSETS_DIR "@BUILTIN_ASSETS_DIR@"
#define ENGINE_EXAMPLES_DIR "@EXAMPLES_DIR@"
#define ENGINE_TESTS_DIR "@TESTS_DIR@"
#define ENGINE_THIRD_PARTY_DIR "@THIRD_PARTY_DIR@"
#define ENGINE_PROJECTS_DIR "@PROJECTS_DIR@"
// Physics SPIR-V is compiled per configuration (Debug keeps glslangValidator's
// -gVS debug info), so the artefacts live in a configuration subdirectory.
// ENGINE_PHYSICS_SPIRV_CONFIG_SUBDIR is defined per configuration by
// engine/Physics/CMakeLists.txt.
#if defined(ENGINE_PHYSICS_SPIRV_CONFIG_SUBDIR)
#define ENGINE_PHYSICS_SPIRV_DIR "@PHYSICS_SPIRV_ROOT@/" ENGINE_PHYSICS_SPIRV_CONFIG_SUBDIR
#else
#define ENGINE_PHYSICS_SPIRV_DIR "@PHYSICS_SPIRV_ROOT@"
#endif
