// Generated configuration header. Never edit the generated copy: change
// engine/cmake_config.h.in and reconfigure.
//
// This header carries no filesystem path: it names only the layout of a runtime
// data root. Where that root is comes from the runtime locator
// (Core/FileSystem/DataRoot.h), which reads NEEDRENAME_DATA_ROOT or looks beside
// the executable - so a binary is independent of the machine that built it.

// --- Layout constants: subdirectory names beneath the runtime data root -----
